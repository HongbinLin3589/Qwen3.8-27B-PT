# Copy to .env at the repository root, fill locally, and do not commit .env.
# All values are intentionally blank. Neither plan nor the mock demo needs keys.

# Model under test: OpenAI-compatible /chat/completions endpoint.
# Local vLLM/SGLang example base URL: http://127.0.0.1:8000/v1
# Use the served model name. Do not put a checkpoint path here unless the server
# exposes that path as its model name. Pin its immutable revision in the YAML.
BENCHMARK_BASE_URL=
BENCHMARK_MODEL=
BENCHMARK_API_KEY=

# Optional separate judge. Required only for scorer.type: llm_judge.
# May point to an open-weight model server or an API provider.
# Fill JUDGE_MODEL with a model ID that your chosen endpoint actually supports.
# Example only, not a default or availability promise: gpt-5.6-sol
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
