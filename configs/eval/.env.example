# Copy to .env at the repository root, fill locally, and do not commit .env.
# All values are intentionally blank. Neither plan nor the mock demo needs keys.

# Model under test: OpenAI-compatible /chat/completions endpoint.
# Local vLLM/SGLang example base URL: http://127.0.0.1:8000/v1
# Use the served model name. Do not put a checkpoint path here unless the server
# exposes that path as its model name. Use a frozen checkpoint/export identity.
BENCHMARK_BASE_URL=
BENCHMARK_MODEL=
BENCHMARK_API_KEY=
BENCHMARK_REVISION=

# Optional Hugging Face credential for gated sources such as GPQA.
# Your Hugging Face account must already have access to the dataset.
HF_TOKEN=

# Official LiveCodeBench execution grader image. Build with
# scripts/eval/Dockerfile.livecodebench, inspect its full sha256: ID, and fill it.
# Only test payloads enter the grading container; model/judge keys do not.
LCB_SANDBOX_IMAGE=

# Optional separate judge. Required only for scorer.type: llm_judge.
# May point to an open-weight model server or an API provider.
# Fill JUDGE_MODEL with a model ID that your chosen endpoint actually supports.
# Initial core/scenarios use deterministic graders; leave these blank there.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
